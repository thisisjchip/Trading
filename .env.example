# =============================================================================
# Kraken Trend-Following Trading System — environment configuration
# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
# =============================================================================

# --- Execution safety gate ------------------------------------------------
# Real orders are ONLY placed when this is exactly "true". Anything else
# (unset, "false", "0", "paper") keeps the system in paper/sim mode.
LIVE=false

# Which exchange adapter the app targets by default.
# One of: kraken_spot | kraken_futures | kraken_us_perps
EXCHANGE=kraken_futures

# --- Kraken Spot (REST/WS) -------------------------------------------------
# Create at https://www.kraken.com/u/security/api
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_API_SECRET=

# --- Kraken Futures (demo-futures by default) ------------------------------
# Demo keys: https://demo-futures.kraken.com  (separate from production!)
# Production keys: https://futures.kraken.com
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=
# "true" => https://demo-futures.kraken.com  (default, paper)
# "false" => https://futures.kraken.com      (production — requires LIVE=true)
KRAKEN_FUTURES_DEMO=true

# --- Kraken US Perps (CFTC-regulated, NOT live yet) ------------------------
# Endpoint/route TBD at launch (standard futures API vs Bitnomial-specific).
# Leave blank until Kraken provides US-perp credentials/endpoint.
KRAKEN_US_PERPS_API_KEY=
KRAKEN_US_PERPS_API_SECRET=
KRAKEN_US_PERPS_BASE_URL=

# --- Data cache ------------------------------------------------------------
# Local OHLCV cache directory (parquet). Created if missing.
DATA_CACHE_DIR=data/cache
